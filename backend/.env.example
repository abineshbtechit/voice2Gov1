# Application
APP_NAME=Voice2Gov API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=voice2gov
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Request-ID"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/heic"]

# Image Storage (Phase 1.3.4)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=uploads
STORAGE_LOCAL_URL=http://localhost:8000/uploads
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600
MAX_IMAGES_PER_REQUEST=5
MAX_EVIDENCE_SIZE_MB=10
MAX_PROGRESS_SIZE_MB=5
MAX_COMPLETION_SIZE_MB=5
MAX_IMAGE_FILENAME_LENGTH=100
IMAGE_UPLOAD_RATE_LIMIT=10

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json