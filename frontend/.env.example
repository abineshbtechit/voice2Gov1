# Voice2Gov Frontend Environment Configuration
#
# Choose or configure the API URL according to your target device/environment:
#
# 1. Waydroid (Linux Host Bridge):
#    Check host bridge IP using: `ip -4 addr show waydroid0` (typically 192.168.240.1)
#    EXPO_PUBLIC_API_URL=http://192.168.240.1:8000
#
# 2. Physical Android Device / Expo Go over LAN:
#    Check host LAN IP using: `ip -4 addr show` or `hostname -I` (e.g. 192.168.1.70)
#    EXPO_PUBLIC_API_URL=http://<YOUR_HOST_LAN_IP>:8000
#
# 3. Android Studio Official Emulator:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# 4. Team Development Server:
#    EXPO_PUBLIC_API_URL=https://dev-api.yourdomain.com
#
# 5. Production Domain:
#    EXPO_PUBLIC_API_URL=https://api.voice2gov.org

EXPO_PUBLIC_API_URL=http://192.168.240.1:8000

